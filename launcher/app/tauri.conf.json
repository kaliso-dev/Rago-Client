{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rago",
  "version": "0.1.0",
  "identifier": "gg.rago.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rago",
        "width": 1040,
        "height": 640,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0B0A0D",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Rago",
    "shortDescription": "Launcher de Rago Client",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
