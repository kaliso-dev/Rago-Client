# 1.6.2 : risqué sur Hypixel (un avertissement, jamais un verrou), copie du chat
rago.risk.title=Risqué sur Hypixel
rago.risk.note=Rago ne bloque rien : tu choisis où tu l'utilises.
rago.risk.tooltip=Risqué sur Hypixel : %s
